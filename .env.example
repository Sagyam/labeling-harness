# Copy to .env and fill in. Nothing in this file is committed with real values.

# --- Postgres -----------------------------------------------------------------
HARNESS_DATABASE__USER=harness
HARNESS_DATABASE__PASSWORD=harness
HARNESS_DATABASE__NAME=harness
POSTGRES_HOST_PORT=5432

# --- Object storage -----------------------------------------------------------
# 'local' keeps the harness usable with MinIO stopped; 'minio' is used in compose.
HARNESS_STORAGE__BACKEND=local
HARNESS_STORAGE__MINIO__ACCESS_KEY=minioadmin
HARNESS_STORAGE__MINIO__SECRET_KEY=minioadmin
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# --- API ----------------------------------------------------------------------
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173
# Leave empty for no authentication (local dev). Set to require a bearer token.
HARNESS_API__AUTH_TOKEN=

# --- Inference providers (required to ingest audio) ---------------------------
# Every call is logged to `llm_requests` whichever vendor served it; that log is the only
# record of what an ingest spent (D34). Set a GCP budget alert separately.
# OpenRouter carries MAI-Transcribe 2 and all text inference.
OPENROUTER_API_KEY=
# ElevenLabs carries Scribe v2. Scope the key to speech-to-text only.
ELEVEN_LABS_API_KEY=
# Vertex AI carries Gemini 3.5 Transcribe and Gemini 3.8 Flash (D39). One API key, restricted to
# aiplatform.googleapis.com -- no Application Default Credentials and no service account file.
# Create one with:
#   gcloud services api-keys create --display-name="labeling-harness vertex" \
#     --api-target=service=aiplatform.googleapis.com
VERTEX_API_KEY=
# Project the Vertex calls bill and quota against, and the region serving the models. `global`
# serves both; `us-central1` is the only other location carrying Gemini 3.5 Transcribe.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# --- Forced alignment ---------------------------------------------------------
# The CTC aligner model (~317 MB) downloads itself on first use, pinned to a revision and
# checked against a digest. Set to 1 to refuse the download and skip word spans instead.
HARNESS_ALIGNER_NO_DOWNLOAD=
# Where it is kept. Defaults to backend/app/services/models; the container uses /app/data/models.
HARNESS_ALIGNER_MODEL_DIR=

# --- Tests --------------------------------------------------------------------
# Postgres URL used by the test suite. Tests create and drop their own schema.
TEST_DATABASE_URL=postgresql+psycopg://harness:harness@localhost:5432/harness_test
