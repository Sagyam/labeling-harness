{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.80",
        "--headless",
        "--executable-path", "/usr/bin/chromium",
        "--viewport-size", "1440,900",
        "--console-level", "warning",
        "--isolated"
      ]
    },
    "colab-mcp": {
      "command": "uvx",
      "args": ["git+https://github.com/googlecolab/colab-mcp@v1.0.2"],
      "timeout": 30000
    }
  }
}
